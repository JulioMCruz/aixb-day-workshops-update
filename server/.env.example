# AI x Blockchain Day — server/.env example
# Copy this file to .env and fill the values you want to use.
# Nothing here is required: when a variable is missing, the server falls
# back to a local fixture so the workshop keeps working.

# Workshop stage (1..4) the server boots into.
# 1 = brain API
# 2 = Mentor Agent setup (wallet + GitHub)
# 3 = Mentor Agent web and API
# 4 = x402 payment gate + ERC-8004 discovery
WORKSHOP_STAGE=4

# Port the server listens on. Frutero's docs use 3001.
PORT=3001

# Nebius Token Factory (reasoning). Optional.
# If both NEBIUS_API_KEY and NEBIUS_MODEL are set, the server calls Nebius live.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Groq — Plan B (free tier, OpenAI-compatible).
# If Nebius fails OR is not configured, the server tries Groq.
# Get a free key at https://console.groq.com (3 min onboarding).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ERC-8004 identity — surfaced via /.well-known/agent-registration.json
ERC8004_AGENT_ID=1
ERC8004_AGENT_REGISTRY=eip155:84532:0x0000000000000000000000000000000000008004

# Public base URL advertised in the agent registration file.
PUBLIC_BASE_URL=http://localhost:3001

# x402 (stage 4). Default mode is "fixture" — payments are simulated.
# Switch to "base-sepolia" only when you want to settle a real testnet job.
X402_MODE=fixture
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_USD="$0.001"
X402_PAY_TO=0x6ae164B78ED8743022047d0CCE08e2F7A3A591A9
# Wallet private key used by `npm run x402:pay` (testnet only — never mainnet).
X402_BUYER_PRIVATE_KEY=
# Server's seller agent wallet private key. Used by:
#   1. The server-side /x402/pay flow to receive testnet USDC
#   2. The "Register seller agent (server-side)" UI button to mint an
#      ERC-8004 NFT whose owner is this wallet (the canonical agent
#      identity, separate from the user's MetaMask).
# Testnet only — never mainnet.
# If set, the address is derived automatically (X402_PAY_TO is overridden).
# Generate a new testnet wallet with: npm run wallet:create
AGENT_PRIVATE_KEY=
